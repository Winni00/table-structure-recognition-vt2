@@ -229,3 +230,31 @@ class TEDS:
             return 1.0 - (float(distance) / n_nodes)
         else:
             return 0.0
+
+    def batch_evaluate(self, pred_json, true_json):
+        """
+        Computes TEDS scores for a batch of samples, matching the PubTabNet API.
+
+        Args:
+            pred_json: Mapping from filename to predicted HTML.
+            true_json: Mapping from filename to {"html": ground-truth HTML}.
+
+        Returns:
+            Mapping from filename to TEDS score.
+        """
+        samples = true_json.keys()
+        if self.n_jobs == 1:
+            scores = [
+                self.evaluate(pred_json.get(filename, ""), true_json[filename]["html"])
+                for filename in samples
+            ]
+        else:
+            with mp.Pool(processes=self.n_jobs) as pool:
+                scores = pool.starmap(
+                    self.evaluate,
+                    [
+                        (pred_json.get(filename, ""), true_json[filename]["html"])
+                        for filename in samples
+                    ],
+                )
+        return dict(zip(samples, scores))
