+def apply_legacy_mbart_attention(model: MBartForCausalLM) -> None:
+    """Patch MBART attention with a cache-free legacy implementation.
+
+    TFLOP injects a custom bbox-token prefix into the decoder input stream.
+    Recent transformers releases changed MBART attention internals and cache
+    handling enough that the original TFLOP decoder no longer runs reliably.
+    For inference on small benchmark sets, a cache-free legacy attention path
+    is a practical compatibility layer.
+    """
+    for module in model.model.modules():
+        if isinstance(module, MBartAttention):
+            module.forward = partial(mbart_attention_legacy_forward, module)
+
+
+def mbart_attention_legacy_forward(
+    mbart_attention_module: MBartAttention,
+    hidden_states: torch.Tensor,
+    key_value_states: Optional[torch.Tensor] = None,
+    past_key_values: Optional[Any] = None,
+    attention_mask: Optional[torch.Tensor] = None,
+    layer_head_mask: Optional[torch.Tensor] = None,
+    output_attentions: bool = False,
+    cache_position: Optional[torch.Tensor] = None,
+    **kwargs,
+) -> Tuple[torch.Tensor, Optional[torch.Tensor], Optional[Tuple[torch.Tensor]]]:
+    """Legacy attention forward compatible with TFLOP's decoder prefixing."""
+    del past_key_values, cache_position, kwargs
+
+    is_cross_attention = key_value_states is not None
+    bsz, tgt_len, _ = hidden_states.size()
+    current_states = key_value_states if is_cross_attention else hidden_states
+    src_len = current_states.shape[1]
+
+    query_states = mbart_attention_module.q_proj(hidden_states).view(
+        bsz, tgt_len, mbart_attention_module.num_heads, mbart_attention_module.head_dim
+    ).transpose(1, 2)
+    key_states = mbart_attention_module.k_proj(current_states).view(
+        bsz, src_len, mbart_attention_module.num_heads, mbart_attention_module.head_dim
+    ).transpose(1, 2)
+    value_states = mbart_attention_module.v_proj(current_states).view(
+        bsz, src_len, mbart_attention_module.num_heads, mbart_attention_module.head_dim
+    ).transpose(1, 2)
+
+    attn_weights = torch.matmul(
+        query_states,
+        key_states.transpose(2, 3),
+    ) * mbart_attention_module.scaling
+    if attention_mask is not None:
+        attn_weights = attn_weights + attention_mask
+
+    attn_weights = nn.functional.softmax(attn_weights, dim=-1)
+    if layer_head_mask is not None:
+        attn_weights = attn_weights * layer_head_mask.view(1, -1, 1, 1)
+
+    attn_weights = nn.functional.dropout(
+        attn_weights,
+        p=mbart_attention_module.dropout if mbart_attention_module.training else 0.0,
+        training=mbart_attention_module.training,
+    )
+    attn_output = torch.matmul(attn_weights, value_states)
+    attn_output = attn_output.transpose(1, 2).contiguous().view(
+        bsz,
+        tgt_len,
+        mbart_attention_module.embed_dim,
+    )
+    attn_output = mbart_attention_module.out_proj(attn_output)
+
+    # Return a tuple placeholder for past_key_value so downstream concatenation
+    # logic does not fail even when caching is disabled.
+    return attn_output, attn_weights if output_attentions else None, (None, None)
+
+
