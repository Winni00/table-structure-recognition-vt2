     assert len(state_dict_map) == 2
     if state_dict_map["key"] == "encoder":
-        model.encoder.load_state_dict(state_dict_map["value"])
+        # Some TFLOP checkpoints are aligned to Swin encoders with downsample
+        # layers starting at index 0, while others start at index 1. Detect the
+        # active layout to avoid size-mismatch when loading weights.
+        has_layer0_downsample = any(
+            name.startswith("model.layers.0.downsample")
+            for name, _ in model.encoder.named_parameters()
+        )
+
+        encoder_state_dict = {}
+        for key, value in state_dict_map["value"].items():
+            if key.endswith("attn.relative_position_index") or key.endswith("attn_mask"):
+                continue
+
+            new_key = key
+            if not has_layer0_downsample:
+                if key.startswith("model.layers.0.downsample."):
+                    new_key = key.replace(
+                        "model.layers.0.downsample.",
+                        "model.layers.1.downsample.",
+                        1,
+                    )
+                elif key.startswith("model.layers.1.downsample."):
+                    new_key = key.replace(
+                        "model.layers.1.downsample.",
+                        "model.layers.2.downsample.",
+                        1,
+                    )
+                elif key.startswith("model.layers.2.downsample."):
+                    new_key = key.replace(
+                        "model.layers.2.downsample.",
+                        "model.layers.3.downsample.",
+                        1,
+                    )
+
+            encoder_state_dict[new_key] = value
+
+        model.encoder.load_state_dict(encoder_state_dict, strict=False)
     elif state_dict_map["key"] == "decoder":
         model.decoder.load_state_dict(state_dict_map["value"])
     else:
